{
  "name": "@ssh-central/desktop",
  "version": "1.5.0",
  "private": true,
  "description": "SSH Central - Electron Main Process + Preload",
  "author": "Alexander Koch <https://www.alexanderkoch.dev/>",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/alexanderkochdev/ssh-central",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,desktop \"vite --config ../renderer/vite.config.ts --port 5173\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron-dev.mjs\"",
    "build": "node scripts/generate-icons.mjs && electron-vite build && node scripts/copy-renderer.mjs",
    "package": "electron-builder --config electron-builder.yml --publish never",
    "package:win": "electron-builder --win --config electron-builder.yml --publish never",
    "package:linux": "electron-builder --linux --config electron-builder.yml --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf out release"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@ssh-central/ipc-contracts": "workspace:*",
    "@ssh-central/sftp": "workspace:*",
    "@ssh-central/ssh-core": "workspace:*",
    "@ssh-central/vault": "workspace:*",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.6.2",
    "kdbxweb": "^2.1.1",
    "ssh2": "^1.17.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@ssh-central/renderer": "workspace:*",
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/unzipper": "^0.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "adm-zip": "^0.6.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "^5.4.1",
    "png-to-ico": "^2.1.8",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
