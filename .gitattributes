# Normalize line endings to LF in the repo, checkout native on Windows
* text=auto eol=lf

# Binary files - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.zip binary
*.vsix binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Lockfiles
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf

# Docs
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Language detection hints for linguist
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
