    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@ssh-central/ipc-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
