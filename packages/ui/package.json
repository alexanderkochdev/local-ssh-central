{
  "name": "@ssh-central/ui",
  "version": "1.0.0",
  "description": "Geteilte React-Komponenten und Material-UI Theme fuer SSH Central",
  "license": "GPL-3.0-only",
  "author": "Alexander Koch <https://www.alexanderkoch.dev/>",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
