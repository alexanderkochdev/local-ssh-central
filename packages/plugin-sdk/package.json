{
  "name": "@ssh-central/plugin-sdk",
  "version": "1.3.0",
  "description": "SDK zum Entwickeln von SSH Central Plugins - Typen, definePlugin-Helper und Build/Pack-CLI",
  "license": "GPL-3.0-only",
  "author": "Alexander Koch <https://www.alexanderkoch.dev/>",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexanderkochdev/local-ssh-central"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts"
    }
  },
  "bin": {
    "ssh-central-plugin": "bin/ssh-central-plugin.mjs"
  },
  "files": ["dist", "bin", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
